@model PortalHome
@{ Layout = "_Portal"; ViewData["Page"] = "donate"; ViewData["Title"] = "Donate"; }

<section class="band-red">
    <div class="wrap narrow">
        <span class="eyebrow">Donate</span>
        <h1>Help reach people faster</h1>
        <p>Your donation supports flood relief and first aid training across Sri Lanka.</p>
    </div>
</section>
<section class="sec">
    <div class="wrap narrow donate-grid">
        <form class="dark-card" id="donate-form" novalidate>
            <h2>Choose an amount</h2>
            <div class="amounts" role="group" aria-label="Amount">
                <button type="button" class="chip" data-amount="1000">LKR 1,000</button>
                <button type="button" class="chip on" data-amount="2500">LKR 2,500</button>
                <button type="button" class="chip" data-amount="5000">LKR 5,000</button>
                <button type="button" class="chip" data-amount="10000">LKR 10,000</button>
            </div>
            <div class="field"><label class="form-label" for="d-amount">Amount (LKR)</label><input class="form-control num" id="d-amount" name="amount" type="number" min="100" step="100" value="2500" required></div>
            <div class="field"><label class="form-label" for="d-name">Name (optional)</label><input class="form-control" id="d-name" name="name" maxlength="160" autocomplete="name"></div>
            <div class="field"><label class="form-label" for="d-email">Email for the receipt (optional)</label><input class="form-control" id="d-email" name="email" type="email" maxlength="200" placeholder="you@example.com" autocomplete="email"></div>
            <button class="btn btn-danger btn-lg" type="submit">Donate</button>
        </form>
        <div class="white-card">
            <h2>How your donation works</h2>
            <div class="lines">
                <span><b>Payment</b><br>Your donation is paid through the payment gateway.</span>
                <span><b>Receipt</b><br>You get a receipt by email.</span>
                <span><b>Where it goes</b><br>Flood relief and first aid training.</span>
            </div>
            <a class="btn btn-dark mt-auto align-self-start" href="/find?kind=help">Find help near you</a>
        </div>
    </div>
</section>

@section scripts { <script src="~/js/portal.js" asp-append-version="true"></script> }
