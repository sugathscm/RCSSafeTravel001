@model PortalHome
@{
    Layout = "_Portal"; ViewData["Page"] = "home";
    var c = Model.Content;
    bool On(string s) => !c.Sections.TryGetValue(s, out var v) || v;
    string Dot(string level) => level == "red" ? "" : level;
}
@section styles { <link rel="stylesheet" href="~/lib/leaflet/dist/leaflet.css"> }

<section class="hero">
    <div class="wrap">
        <div class="hmain">
            <span class="hbadge"><span class="logo-dot"><img src="~/img/slrcs-logo.png" alt="" data-logo></span><span>Official travel-safety service of the Red Cross</span></span>
            <h1>@c.HeroTitle</h1>
            <p>@c.HeroText</p>
            <div class="hrow">
                <a class="btn btn-danger btn-xl btn-glow" href="/find?kind=help">Find help near you</a>
                <a class="btn btn-glass btn-xl" href="/map">Open the live map →</a>
            </div>
        </div>
        @if (On("alerts") && Model.Alerts.Count > 0)
        {
            <div class="live" id="live-alerts">
                <h4><span><span class="dot"></span> Live right now</span><span class="upd">Updated <time datetime="@(Model.Alerts.Max(a => a.PublishedUtc).ToString("o"))" data-ago></time></span></h4>
                @foreach (var a in Model.Alerts.Take(3))
                {
                    <a class="al" href="/alerts#alert-@a.Id">
                        <span class="dot @Dot(a.Level)"></span>
                        <span class="txt"><span class="k">@a.Type · @a.Area</span><b>@a.Title</b></span>
                        <time datetime="@a.PublishedUtc.ToString("o")" data-ago></time>
                    </a>
                }
            </div>
        }
    </div>
</section>
<div class="srcs"><div class="wrap"><span class="eyebrow mute">Alerts &amp; data from</span><span>Disaster Management Centre</span><span>NBRO</span><span>Dept. of Meteorology</span><span>Ministry of Health</span></div></div>

@if (On("ads") && Model.Ads.Count > 0)
{
    <section class="sec adsec" aria-label="Sponsor advertisements">
        <div class="wrap">
            <span class="eyebrow mute">Sponsored</span>
            <div class="ads">
                @foreach (var ad in Model.Ads)
                {
                    <a class="ad ad-@ad.Slot" href="@ad.LinkUrl" target="_blank" rel="sponsored noopener" data-ad="@ad.Id">
                        @if (ad.ImageUrl is not null) { <img src="@ad.ImageUrl" alt="" loading="lazy"> }
                        <span class="ad-body">
                            <span class="ad-by">@ad.Sponsor</span>
                            <b>@ad.Headline</b>
                            @if (ad.Text.Length > 0) { <span class="small">@ad.Text</span> }
                            <span class="ad-go">@ad.LinkLabel →</span>
                        </span>
                    </a>
                }
            </div>
        </div>
    </section>
}

@if (On("map"))
{
    <section class="sec first">
        <div class="wrap split">
            <div>
                <span class="eyebrow">Find help</span>
                <h2>Banks, SOS points and police stations on one map</h2>
                <p class="lead">Every help point is kept up to date by the admin team. Choose a category to see the list, or tap a pin.</p>
                <div class="chips">
                    @foreach (var cat in Model.Categories.Where(x => x.Kind == "help"))
                    {
                        <a class="chip" href="/find?kind=help&category=@cat.Slug"><span>@cat.Icon</span>@cat.Name</a>
                    }
                </div>
                <a class="btn btn-dark btn-lg mt-4" href="/map">Open the full map →</a>
            </div>
            <div class="map" id="help-map" role="application" aria-label="Map of help points"></div>
        </div>
    </section>
}

@if (On("topics") && c.Topics.Count > 0)
{
    <section class="sec">
        <div class="wrap">
            <div class="sec-head">
                <div>
                    <span class="eyebrow">Safety topics</span>
                    <h2>Know before you go</h2>
                </div>
                <a class="btn btn-text" href="/topics">All topics →</a>
            </div>
            <div class="cards mt-0">
                @foreach (var t in c.Topics)
                {
                    <a class="tcard tone-@t.Tone" href="/topics/@t.Id"><span class="ic">@t.Icon</span><h3>@t.Name</h3><p class="small">@t.Summary</p></a>
                }
            </div>
        </div>
    </section>
}

@if (On("businesses") && Model.Businesses.Count > 0)
{
    <section class="sec">
        <div class="wrap">
            <div class="band">
                <div class="intro">
                    <span class="eyebrow">Verified businesses</span>
                    <h2>Places travellers can trust</h2>
                    <p class="lead">Every business here is registered, checked by the admin team and renewed each year.</p>
                    <div class="hrow">
                        <a class="btn btn-danger btn-lg" href="/find?kind=business">See all businesses →</a>
                        <a class="btn btn-line btn-lg" href="/register">List your business</a>
                    </div>
                </div>
                <div class="places">
                    @foreach (var l in Model.Businesses)
                    {
                        <a class="place" href="/listing/@l.Id">
                            <span class="ic">@l.Icon</span>
                            <div class="txt">
                                <h3>@l.Name</h3>
                                <span class="meta">@l.Category · @l.Town</span>
                                <span class="tags">
                                    @if (l.IsVerified) { <span class="pill ok">✓ Verified</span> }
                                    @if (l.Rating > 0) { <span class="pill warn">★ @l.Rating.ToString("0.0")</span> }
                                    @if (l.Promotion is not null) { <span class="promo-badge">Promotion</span> }
                                </span>
                                @if (l.Promotion is not null) { <span class="promo-line">@l.Promotion.Title</span> }
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>
    </section>
}

<section class="sec">
    <div class="wrap duo">
        <a class="big tone-green" href="/register">
            <span class="emoji">🏪</span>
            <h3>Own a business?</h3>
            <p>Register, upload your documents and pay LKR @c.AnnualFee.ToString("N0") a year to appear on the map and in the app.</p>
            <span class="go">List your business →</span>
        </a>
        @if (On("donate"))
        {
            <a class="big tone-rose" href="/donate">
                <span class="emoji">❤️</span>
                <h3>Support disaster response</h3>
                <p>Donations support flood relief and first aid training across Sri Lanka.</p>
                <span class="go">Donate →</span>
            </a>
        }
    </div>
</section>

@if (On("sponsors") && c.Sponsors.Count > 0)
{
    <section class="sec pt-0">
        <div class="wrap">
            <span class="eyebrow mute">Sponsors</span>
            <div class="spons">
                @foreach (var s in c.Sponsors)
                {
                    <div class="spon"><b>@s.Name</b><span class="small mute">@s.Role</span></div>
                }
            </div>
        </div>
    </section>
}

@section scripts {
    <script src="~/lib/leaflet/dist/leaflet.js"></script>
    <script src="~/js/portal.js" asp-append-version="true"></script>
}
