{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
  "AllowedHosts": "*",
  "Database": { "Provider": "SqlServer", "MigrateOnStart": true },
  "ConnectionStrings": {
    "Default": "Data Source=YOUR_SERVER;Initial Catalog=YOUR_DB;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },
  "Jwt": { "Key": "", "Issuer": "SafeTravel", "Audience": "SafeTravel.Apps", "AccessMinutes": 15, "RefreshDays": 30 },
  "Seed": { "StaffPassword": "", "SampleData": false },
  "RateLimits": { "ApiPerMinute": 300, "AuthPerMinute": 10, "PublicWritesPerMinute": 20 },
  "Renewals": { "Enabled": true, "EveryHours": 6 },
  "Uploads": { "Path": "App_Data/uploads" }
}
